@model SV22T1020161.Models.Partner.Customer
@{
    ViewBag.Title = "Cập nhật khách hàng";
}
<div class="card card-primary card-outline mb-4">
    <div class="card-header">
        <h3 class="card-title">Cập nhật thông tin khách hàng</h3>
    </div>
    <form asp-action="Edit" method="post">
        <div class="card-body">
            <input type="hidden" name="CustomerID" value="@Model.CustomerID" />

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Tên khách hàng: <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="CustomerName"
                               value="@Model.CustomerName" placeholder="Nhập tên khách hàng"
                               required maxlength="255" autofocus
                               oninvalid="this.setCustomValidity('Vui lòng nhập tên khách hàng')"
                               oninput="this.setCustomValidity('')" />
                        @Html.ValidationMessage("CustomerName", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Tên giao dịch: <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="ContactName"
                               value="@Model.ContactName" placeholder="Nhập tên giao dịch"
                               required maxlength="255"
                               oninvalid="this.setCustomValidity('Vui lòng nhập tên giao dịch')"
                               oninput="this.setCustomValidity('')" />
                        @Html.ValidationMessage("ContactName", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Điện thoại:</label>
                        <input type="tel" class="form-control" name="Phone"
                               value="@Model.Phone" placeholder="Nhập số điện thoại" maxlength="20"
                               pattern="[0-9]{9,15}"
                               oninvalid="this.setCustomValidity('Số điện thoại phải là chữ số, từ 9 đến 15 ký tự')"
                               oninput="this.setCustomValidity('')" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Email: <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" name="Email"
                               value="@Model.Email" placeholder="Nhập email"
                               required maxlength="50"
                               oninvalid="this.setCustomValidity('Vui lòng nhập địa chỉ email hợp lệ')"
                               oninput="this.setCustomValidity('')" />
                        @Html.ValidationMessage("Email", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Tỉnh/Thành phố: <span class="text-danger">*</span></label>
                        <select class="form-select" name="Province" required
                                oninvalid="this.setCustomValidity('Vui lòng chọn tỉnh/thành phố')"
                                onchange="this.setCustomValidity('')">
                            <option value="">-- Chọn tỉnh/thành --</option>
                            @if (ViewBag.Provinces != null)
                            {
                                foreach (var item in ViewBag.Provinces)
                                {
                                    if (item.ProvinceName == Model.Province)
                                    {
                                        <option value="@item.ProvinceName" selected>@item.ProvinceName</option>
                                    }
                                    else
                                    {
                                        <option value="@item.ProvinceName">@item.ProvinceName</option>
                                    }
                                }
                            }
                        </select>
                        @Html.ValidationMessage("Province", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label d-block">Trạng thái tài khoản</label>
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" name="IsLocked"
                                   value="true" @(Model.IsLocked ? "checked" : "") />
                            <label class="form-check-label">Khóa tài khoản</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="mb-3">
                        <label class="form-label">Địa chỉ:</label>
                        <textarea class="form-control" name="Address" rows="2"
                                  placeholder="Nhập địa chỉ" maxlength="255">@Model.Address</textarea>
                    </div>
                </div>
            </div>

            <div class="text-danger">
                @Html.ValidationSummary(true)
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Lưu thông tin
            </button>
            <a href="~/Customer" class="btn btn-secondary">
                <i class="bi bi-x-circle"></i> Hủy bỏ
            </a>
        </div>
    </form>
</div>
