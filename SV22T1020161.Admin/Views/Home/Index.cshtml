@using SV22T1020161.Models.Sales
@{
    var todayRevenue = ViewBag.TodayRevenue;
    var pendingOrders = ViewBag.PendingOrders;
    var customerCount = ViewBag.CustomerCount;
    var productCount = ViewBag.ProductCount;
    var recentOrders = ViewBag.RecentOrders as List<OrderViewInfo>;
    var monthlyRevenue = ViewBag.MonthlyRevenue as List<SV22T1020161.DataLayers.Interfaces.MonthlyRevenue>;
}

<!-- Thống kê nhanh -->
<div class="row">
    <div class="col-lg-3 col-6">
        <div class="card text-bg-primary">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Doanh thu hôm nay</h6>
                        <h3 class="mb-0">@todayRevenue.ToString("N0") đ</h3>
                    </div>
                    <i class="bi bi-currency-dollar fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="card text-bg-success">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Đơn hàng chờ duyệt</h6>
                        <h3 class="mb-0">@pendingOrders</h3>
                    </div>
                    <i class="bi bi-receipt fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="card text-bg-warning">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Khách hàng</h6>
                        <h3 class="mb-0">@customerCount</h3>
                    </div>
                    <i class="bi bi-people fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="card text-bg-danger">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Sản phẩm đang bán</h6>
                        <h3 class="mb-0">@productCount</h3>
                    </div>
                    <i class="bi bi-box-seam fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Biểu đồ & thống kê -->
<div class="row mt-3">
    <div class="col-lg-8">
        <div class="card card-success card-outline">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-bar-chart me-1"></i>
                    Doanh thu theo tháng
                </h5>
            </div>
            <div class="card-body">
                <canvas id="revenueChart" height="150"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-clock-history me-1"></i>
                    Đơn hàng mới cần xử lý
                </h5>
            </div>
            <div class="card-body p-0">
                @if (recentOrders != null && recentOrders.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var order in recentOrders)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>#@order.OrderID</strong> - @order.CustomerName
                                    <br />
                                    <small class="text-muted">@order.OrderTime.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-danger">@order.TotalAmount.ToString("N0") đ</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="p-3 text-center text-muted">
                        <i class="bi bi-check-circle fs-1"></i>
                        <p class="mb-0 mt-2">Không có đơn hàng chờ duyệt</p>
                    </div>
                }
            </div>
            <div class="card-footer text-center">
                <a asp-controller="Order" asp-action="Index" class="text-decoration-none">
                    Xem tất cả đơn hàng <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('revenueChart');
        const monthlyData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
            (monthlyRevenue ?? new List<SV22T1020161.DataLayers.Interfaces.MonthlyRevenue>())
                .Select(m => new { label = m.Label, revenue = m.Revenue }).ToList()
        ));

        const labels = monthlyData.map(m => m.label);
        const revenues = monthlyData.map(m => m.revenue / 1000000);

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels.length ? labels : ['Chưa có dữ liệu'],
                datasets: [{
                    label: 'Doanh thu (triệu đồng)',
                    data: revenues.length ? revenues : [0],
                    backgroundColor: 'rgba(13,110,253,0.7)',
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top'
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                return context.raw + ' triệu đồng';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    </script>
}
