@using Microsoft.AspNetCore.Mvc.Rendering
@using SV22T1020161.Models.Catalog
@using SV22T1020161.Models.Partner
@using SV22T1020161.Models.Sales
@{
    var customers = ViewBag.Customers as IEnumerable<Customer> ?? Enumerable.Empty<Customer>();
    var products = ViewBag.Products as IEnumerable<Product> ?? Enumerable.Empty<Product>();
    var provinces = ViewBag.Provinces as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var cart = ViewBag.Cart as List<OrderDetail> ?? new List<OrderDetail>();
    var cartLookup = ViewBag.CartProductLookup as Dictionary<int, Product> ?? new Dictionary<int, Product>();
    var productPage = ViewBag.ProductPage as int? ?? 1;
    var productPageCount = ViewBag.ProductPageCount as int? ?? 1;
    decimal cartTotal = cart.Sum(c => c.TotalPrice);
}

<div class="row">
    <!-- Tìm kiếm & chọn mặt hàng -->
    <div class="col-lg-4">
        <div class="card card-outline card-primary h-100">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-search"></i>
                    Lựa chọn hàng cần bán
                </h5>
            </div>
            <div class="card-body">
                <form id="formSearchProduct"
                      method="get"
                      action="@Url.Action("SearchProducts", "Order")"
                      data-target="productList"
                      class="mb-3">
                    <div class="input-group">
                        <input class="form-control"
                               name="searchValue"
                               id="productSearchInput"
                               placeholder="Nhập tên mặt hàng cần tìm"
                               autofocus />
                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                <div id="productList" class="overflow-auto" style="max-height: 500px;">
                    @foreach (var p in products)
                    {
                        <form class="border rounded p-2 mb-2" onsubmit="return addToCartFromForm(event, this, @p.ProductID, @p.Price.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                            <strong>@p.ProductName</strong>
                            <div class="row mt-2">
                                <div class="col-4">
                                    <img src="~/images/products/@(string.IsNullOrEmpty(p.Photo) ? "nophoto.png" : p.Photo)"
                                         class="img-fluid border"
                                         style="max-height:100px;object-fit:cover;"
                                         onerror="this.src='@Url.Content("~/images/products/demo.png")'" />
                                </div>
                                <div class="col-8">
                                    <div class="row g-2">
                                        <div class="col-7">
                                            <label class="form-label mb-0">Giá</label>
                                            <input class="form-control form-control-sm money-input"
                                                   name="salePriceDisplay"
                                                   value="@p.Price.ToString("0")" />
                                        </div>
                                        <div class="col-5">
                                            <label class="form-label mb-0">SL</label>
                                            <input type="number" name="quantity" min="1" value="1" class="form-control form-control-sm" />
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-sm btn-primary mt-2 w-100">
                                        <i class="bi bi-cart-plus"></i>
                                        Thêm vào giỏ
                                    </button>
                                </div>
                            </div>
                        </form>
                    }
                </div>
            </div>
            <div class="card-footer">
                <ul class="pagination justify-content-between mb-0">
                    <li class="page-item @(productPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="#" id="productPagePrev" role="button" aria-label="Trang trước">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    <li class="page-item align-self-center small text-muted px-2">
                        <span id="productPageLabel">@productPage / @productPageCount</span>
                    </li>
                    <li class="page-item @(productPage >= productPageCount ? "disabled" : "")">
                        <a class="page-link" href="#" id="productPageNext" role="button" aria-label="Trang sau">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Giỏ hàng và thông tin khách hàng -->
    <div class="col-lg-8">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row">
            <div class="col-12">
                <div class="card card-outline card-success">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-cart"></i>
                            Danh sách mặt hàng đã chọn
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (cart.Count == 0)
                        {
                            <p class="text-muted text-center mb-0 py-3">Giỏ hàng trống. Vui lòng chọn mặt hàng.</p>
                        }
                        else
                        {
                            <table class="table table-bordered table-hover align-middle">
                                <thead class="table-success">
                                    <tr>
                                        <th class="text-center">#</th>
                                        <th style="width:auto">Tên hàng</th>
                                        <th class="text-center" style="width:100px">ĐVT</th>
                                        <th class="text-center" style="width:100px">SL</th>
                                        <th class="text-end" style="width:150px">Giá</th>
                                        <th class="text-end" style="width:150px">Thành tiền</th>
                                        <th style="width:80px"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int idx = 1;
                                        foreach (var item in cart)
                                        {
                                            cartLookup.TryGetValue(item.ProductID, out var prod);
                                            var name = prod?.ProductName ?? ("#" + item.ProductID.ToString());
                                            var unit = string.IsNullOrWhiteSpace(prod?.Unit) ? "—" : prod!.Unit;
                                            <tr>
                                                <td class="text-center">@(idx++)</td>
                                                <td>@name</td>
                                                <td class="text-center">@unit</td>
                                                <td class="text-center">@item.Quantity</td>
                                                <td class="text-end">@item.SalePrice.ToString("N0")</td>
                                                <td class="text-end">@item.TotalPrice.ToString("N0")</td>
                                                <td class="text-end text-nowrap">
                                                    @{
                                                        var cartPhoto = string.IsNullOrWhiteSpace(prod?.Photo) ? "nophoto.png" : prod!.Photo;
                                                    }
                                                    <button type="button" class="btn btn-sm btn-primary" title="Sửa"
                                                            data-product-id="@item.ProductID"
                                                            data-quantity="@item.Quantity"
                                                            data-sale-price="@item.SalePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                            data-product-name="@name"
                                                            data-photo="@cartPhoto"
                                                            onclick="openEditCartModal(this)">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <a class="btn btn-sm btn-danger open-modal" title="Xóa"
                                                       href="@Url.Action("DeleteCartLineConfirm", "Order", new { productId = item.ProductID })"
                                                       role="button">
                                                        <i class="bi bi-dash"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th colspan="5" class="text-end">Tổng cộng:</th>
                                        <th class="text-end">@cartTotal.ToString("N0")</th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                            <div class="text-end">
                                <a class="btn btn-danger mt-2 open-modal"
                                   href="@Url.Action("ClearCart", "Order")"
                                   role="button"
                                   title="Xóa toàn bộ giỏ hàng">
                                    <i class="bi bi-trash"></i>
                                    Xóa giỏ hàng
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-12">
                <div class="card card-outline card-info">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-person"></i>
                            Thông tin khách hàng & nơi giao hàng
                        </h5>
                    </div>
                    <div class="card-body">
                        <form method="post" action="~/Order/SaveOrder" id="formCreateOrder">
                            <div class="row mb-3">
                                <label class="col-md-2 col-form-label">Khách hàng</label>
                                <div class="col-md-10">
                                    <select name="customerID" class="form-select" required
                                            oninvalid="this.setCustomValidity('Vui lòng chọn khách hàng')"
                                            onchange="this.setCustomValidity('')">
                                        <option value="">-- Chọn khách hàng --</option>
                                        @foreach (var c in customers)
                                        {
                                            <option value="@c.CustomerID">@c.CustomerName (@c.ContactName)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <label class="col-md-2 col-form-label">Tỉnh/thành</label>
                                <div class="col-md-10">
                                    <select name="deliveryProvince" class="form-select" required
                                            oninvalid="this.setCustomValidity('Vui lòng chọn tỉnh/thành giao hàng')"
                                            onchange="this.setCustomValidity('')">
                                        <option value="">-- Chọn Tỉnh/thành giao hàng --</option>
                                        @foreach (var p in provinces)
                                        {
                                            <option value="@p.Value">@p.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <label class="col-md-2 col-form-label">Địa chỉ</label>
                                <div class="col-md-10">
                                    <textarea name="deliveryAddress" class="form-control" rows="3" required
                                              placeholder="Số nhà, đường, phường/xã..."
                                              oninvalid="this.setCustomValidity('Vui lòng nhập địa chỉ giao hàng')"
                                              oninput="this.setCustomValidity('')"></textarea>
                                </div>
                            </div>
                            <div class="text-end">
                                <button type="submit" class="btn btn-primary" @(cart.Count == 0 ? "disabled" : "")>
                                    <i class="bi bi-check-circle"></i>
                                    Lập đơn hàng
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal sửa dòng giỏ — bố cục theo ui/Views/Order/EditCartItem.cshtml -->
<div class="modal fade" id="editCartLineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <strong class="modal-title">Cập nhật chi tiết đơn hàng</strong>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editCartProductId" />
                <div class="container-fluid px-0">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="row mb-3 align-items-center">
                                <label class="col-sm-4 col-form-label fw-semibold">Mặt hàng</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control-plaintext fw-bold" id="editCartProductName" readonly value="" />
                                </div>
                            </div>
                            <div class="row mb-3 align-items-center">
                                <label class="col-sm-4 col-form-label fw-semibold">Số lượng</label>
                                <div class="col-sm-5">
                                    <input type="number" class="form-control text-end" id="editCartQuantity" min="1" value="1" />
                                </div>
                            </div>
                            <div class="row mb-3 align-items-center">
                                <label class="col-sm-4 col-form-label fw-semibold">Đơn giá</label>
                                <div class="col-sm-5">
                                    <input type="text" class="form-control text-end" id="editCartSalePrice" autocomplete="off" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 text-end">
                            <img id="editCartPhoto" src="" alt="" class="img-thumbnail" style="max-height:180px;object-fit:contain;" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btnSaveEditCart">Cập nhật</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var productSearchPage = @productPage;
        var productSearchPageCount = @productPageCount;
        var productSearchValue = '';
        var productImageBase = '@Url.Content("~/images/products/")';
        var editCartSalePriceAutoNumeric = null;

        function formatVnInteger(n) {
            var x = Math.round(Number(n));
            if (isNaN(x)) x = 0;
            return String(x).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
        }

        function parseMoneyInput(el) {
            if (!el || !el.value) return 0;
            var s = el.value.replace(/\./g, '').replace(/,/g, '.');
            var n = parseFloat(s);
            return isNaN(n) ? 0 : n;
        }

        function addToCartFromForm(evt, form, productId, defaultPrice) {
            evt.preventDefault();
            var qtyInput = form.querySelector('input[name="quantity"]');
            var qty = parseInt(qtyInput && qtyInput.value, 10) || 1;
            var moneyEl = form.querySelector('input[name="salePriceDisplay"]');
            var price = moneyEl ? parseMoneyInput(moneyEl) : defaultPrice;
            if (price <= 0) price = defaultPrice;

            var body = 'productId=' + productId + '&quantity=' + qty + '&salePrice=' + encodeURIComponent(price);
            fetch('@Url.Action("AddToCart", "Order")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body
            }).then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data.success) location.reload();
                    else alert(data.message || 'Có lỗi xảy ra');
                });
            return false;
        }

        function loadProductPage(page) {
            if (page < 1 || page > productSearchPageCount) return;
            productSearchPage = page;
            var url = '@Url.Action("SearchProducts", "Order")?searchValue=' + encodeURIComponent(productSearchValue) + '&page=' + page;
            fetch(url).then(function (r) { return r.json(); })
                .then(function (data) {
                    productSearchPageCount = Math.max(1, data.pageCount || 1);
                    productSearchPage = data.page || 1;
                    var el = document.getElementById('productPageLabel');
                    if (el) el.textContent = productSearchPage + ' / ' + productSearchPageCount;
                    renderProducts(data.dataItems || []);
                    syncPagerState();
                });
        }

        function syncPagerState() {
            var prev = document.getElementById('productPagePrev');
            var next = document.getElementById('productPageNext');
            if (prev) prev.parentElement.classList.toggle('disabled', productSearchPage <= 1);
            if (next) next.parentElement.classList.toggle('disabled', productSearchPage >= productSearchPageCount);
        }

        function renderProducts(products) {
            var container = document.getElementById('productList');
            if (!products || products.length === 0) {
                container.innerHTML = '<p class="text-muted text-center">Không tìm thấy sản phẩm.</p>';
                return;
            }
            var html = '';
            products.forEach(function (p) {
                var photo = p.photo || 'nophoto.png';
                var price = Number(p.price);
                html += '<form class="border rounded p-2 mb-2" onsubmit="return addToCartFromForm(event, this, ' + p.productID + ', ' + price + ')">' +
                    '<strong>' + (p.productName || '') + '</strong>' +
                    '<div class="row mt-2">' +
                    '<div class="col-4"><img src="@Url.Content("~/images/products/")' + photo + '" class="img-fluid border" style="max-height:100px;object-fit:cover;" onerror="this.src=\'@Url.Content("~/images/products/nophoto.png")\'" /></div>' +
                    '<div class="col-8">' +
                    '<div class="row g-2">' +
                    '<div class="col-7"><label class="form-label mb-0">Giá</label>' +
                    '<input class="form-control form-control-sm money-input" name="salePriceDisplay" value="' + Math.round(price) + '" /></div>' +
                    '<div class="col-5"><label class="form-label mb-0">SL</label>' +
                    '<input type="number" name="quantity" min="1" value="1" class="form-control form-control-sm" /></div></div>' +
                    '<button type="submit" class="btn btn-sm btn-primary mt-2 w-100"><i class="bi bi-cart-plus"></i> Thêm vào giỏ</button>' +
                    '</div></div></form>';
            });
            container.innerHTML = html;
            document.querySelectorAll('#productList .money-input').forEach(function (element) {
                if (typeof AutoNumeric !== 'undefined') {
                    new AutoNumeric(element, {
                        digitGroupSeparator: '.',
                        decimalCharacter: ',',
                        decimalPlaces: 0,
                        unformatOnSubmit: true
                    });
                }
            });
        }

        document.getElementById('formSearchProduct')?.addEventListener('submit', function (e) {
            e.preventDefault();
            productSearchValue = document.getElementById('productSearchInput').value || '';
            productSearchPage = 1;
            loadProductPage(1);
        });

        document.getElementById('productPagePrev')?.addEventListener('click', function (e) {
            e.preventDefault();
            loadProductPage(productSearchPage - 1);
        });
        document.getElementById('productPageNext')?.addEventListener('click', function (e) {
            e.preventDefault();
            loadProductPage(productSearchPage + 1);
        });

        function openEditCartModal(btn) {
            var productId = parseInt(btn.getAttribute('data-product-id'), 10);
            var quantity = parseInt(btn.getAttribute('data-quantity'), 10) || 1;
            var salePrice = parseFloat(btn.getAttribute('data-sale-price')) || 0;
            var productName = btn.getAttribute('data-product-name') || '';
            var photo = btn.getAttribute('data-photo') || 'nophoto.png';

            document.getElementById('editCartProductId').value = productId;
            document.getElementById('editCartProductName').value = productName;
            document.getElementById('editCartQuantity').value = quantity;

            var priceEl = document.getElementById('editCartSalePrice');
            if (typeof AutoNumeric !== 'undefined') {
                if (editCartSalePriceAutoNumeric) {
                    editCartSalePriceAutoNumeric.remove();
                    editCartSalePriceAutoNumeric = null;
                }
                editCartSalePriceAutoNumeric = new AutoNumeric(priceEl, {
                    digitGroupSeparator: '.',
                    decimalCharacter: ',',
                    decimalPlaces: 0,
                    unformatOnSubmit: true
                });
                editCartSalePriceAutoNumeric.set(salePrice);
            } else {
                priceEl.value = formatVnInteger(salePrice);
            }

            var img = document.getElementById('editCartPhoto');
            img.alt = productName;
            img.onerror = function () { this.onerror = null; this.src = productImageBase + 'nophoto.png'; };
            img.src = productImageBase + photo;

            var modal = new bootstrap.Modal(document.getElementById('editCartLineModal'));
            modal.show();
        }

        document.getElementById('btnSaveEditCart')?.addEventListener('click', function () {
            var pid = parseInt(document.getElementById('editCartProductId').value, 10);
            var qty = parseInt(document.getElementById('editCartQuantity').value, 10) || 1;
            var priceEl = document.getElementById('editCartSalePrice');
            var price = editCartSalePriceAutoNumeric
                ? editCartSalePriceAutoNumeric.getNumber()
                : parseMoneyInput(priceEl);
            var body = 'productId=' + pid + '&quantity=' + qty + '&salePrice=' + encodeURIComponent(price);
            fetch('@Url.Action("UpdateCart", "Order")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body
            }).then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data.success) location.reload();
                });
        });

        document.addEventListener('DOMContentLoaded', function () {
            syncPagerState();
            document.querySelectorAll('#productList .money-input').forEach(function (element) {
                if (typeof AutoNumeric !== 'undefined') {
                    new AutoNumeric(element, {
                        digitGroupSeparator: '.',
                        decimalCharacter: ',',
                        decimalPlaces: 0,
                        unformatOnSubmit: true
                    });
                }
            });
        });
    </script>
}
