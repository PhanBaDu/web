@using SV22T1020161.Admin
@using SV22T1020161.Models.Constants
@model SV22T1020161.Models.Sales.OrderViewInfo
@{
    Layout = "_Layout";
    var details = ViewBag.Details as List<SV22T1020161.Models.Sales.OrderDetailViewInfo> ?? new List<SV22T1020161.Models.Sales.OrderDetailViewInfo>();
    var statusColors = new Dictionary<int, string>
    {
        { -2, "alert-danger" },
        { -1, "alert-secondary" },
        { 1, "alert-warning" },
        { 2, "alert-info" },
        { 3, "alert-primary" },
        { 4, "alert-success" }
    };
    var statusTexts = new Dictionary<int, (string icon, string text)>
    {
        { -2, ("bi-x-circle-fill", "Đơn hàng bị từ chối") },
        { -1, ("bi-x-circle-fill", "Đơn hàng đã bị hủy") },
        { 1, ("bi-clock-fill", "Đơn hàng mới - Đang chờ duyệt") },
        { 2, ("bi-check-circle-fill", "Đơn hàng đã được duyệt") },
        { 3, ("bi-truck", "Đơn hàng đang được vận chuyển") },
        { 4, ("bi-bag-check-fill", "Đơn hàng đã hoàn tất") }
    };
    var badge = statusColors.GetValueOrDefault((int)Model.Status, "alert-secondary");
    var (icon, text) = statusTexts.GetValueOrDefault((int)Model.Status, ("bi-question-circle", "Không xác định"));

    var canAccept = Model.Status == SV22T1020161.Models.Sales.OrderStatusEnum.New;
    var canShip = Model.Status == SV22T1020161.Models.Sales.OrderStatusEnum.Accepted;
    var canFinish = Model.Status == SV22T1020161.Models.Sales.OrderStatusEnum.Shipping;
    var canCancel = Model.Status == SV22T1020161.Models.Sales.OrderStatusEnum.New || Model.Status == SV22T1020161.Models.Sales.OrderStatusEnum.Accepted;
    var canReject = Model.Status == SV22T1020161.Models.Sales.OrderStatusEnum.New;
    var canDelete = Model.Status == SV22T1020161.Models.Sales.OrderStatusEnum.New
                 || Model.Status == SV22T1020161.Models.Sales.OrderStatusEnum.Cancelled
                 || Model.Status == SV22T1020161.Models.Sales.OrderStatusEnum.Rejected
                 || Model.Status == SV22T1020161.Models.Sales.OrderStatusEnum.Completed;
}

@section PageToolBar {
    @if (canAccept && ApplicationContext.HasPermission(Permissions.OrderAccept))
    {
        <div class="btn-group">
            <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown">
                <i class="bi bi-gear me-1"></i> Xử lý đơn hàng
            </button>
            <ul class="dropdown-menu">
                @if (canAccept && ApplicationContext.HasPermission(Permissions.OrderAccept))
                {
                    <li><a class="dropdown-item open-modal" href="~/Order/Accept/@Model.OrderID">Duyệt đơn hàng</a></li>
                }
                @if (canShip && ApplicationContext.HasPermission(Permissions.OrderShip))
                {
                    <li><a class="dropdown-item open-modal" href="~/Order/Shipping/@Model.OrderID">Chuyển giao hàng</a></li>
                }
                @if (canFinish && ApplicationContext.HasPermission(Permissions.OrderComplete))
                {
                    <li><a class="dropdown-item open-modal" href="~/Order/Finish/@Model.OrderID">Hoàn tất đơn hàng</a></li>
                }
                @if (canReject && ApplicationContext.HasPermission(Permissions.OrderReject))
                {
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger open-modal" href="~/Order/Reject/@Model.OrderID">Từ chối đơn hàng</a></li>
                }
                @if (canCancel && ApplicationContext.HasPermission(Permissions.OrderCancel))
                {
                    <li><a class="dropdown-item text-danger open-modal" href="~/Order/Cancel/@Model.OrderID">Hủy đơn hàng</a></li>
                }
            </ul>
        </div>
    }

    @if (canDelete && ApplicationContext.HasPermission(Permissions.OrderDelete))
    {
        <a href="~/Order/Delete/@Model.OrderID" class="btn btn-danger ms-1 open-modal">
            <i class="bi bi-trash"></i> Xóa
        </a>
    }

    <a href="~/Order" class="btn btn-secondary ms-1">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- TRẠNG THÁI ĐƠN HÀNG -->
<div class="alert @badge d-flex align-items-center mb-3">
    <i class="bi @icon fs-4 me-2"></i>
    <div>
        <strong>Trạng thái:</strong> @text
        @if (Model.FinishedTime.HasValue)
        {
            <span>lúc <b>@Model.FinishedTime.Value.ToString("dd/MM/yyyy HH:mm")</b></span>
        }
    </div>
</div>

<!-- THÔNG TIN ĐƠN HÀNG -->
<div class="card card-primary card-outline mb-3">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="bi bi-receipt me-2"></i>Thông tin đơn hàng</h5>
    </div>
    <div class="card-body ps-4 pe-4">
        <div class="row mb-2 pb-2" style="border-bottom: 1px dotted #ccc;">
            <div class="col-md-3 fw-bold">Mã đơn hàng</div>
            <div class="col-md-3 fw-semibold text-primary">#@Model.OrderID</div>
            <div class="col-md-3 fw-bold">Ngày lập</div>
            <div class="col-md-3">@Model.OrderTime.ToString("dd/MM/yyyy HH:mm")</div>
        </div>
        <div class="row pt-2">
            <div class="col-md-3 fw-bold">Nhân viên xử lý</div>
            <div class="col-md-3">@(string.IsNullOrEmpty(Model.EmployeeName) ? "—" : Model.EmployeeName)</div>
            <div class="col-md-3 fw-bold">Ngày duyệt</div>
            <div class="col-md-3">@(Model.AcceptTime.HasValue ? Model.AcceptTime.Value.ToString("dd/MM/yyyy HH:mm") : "—")</div>
        </div>
    </div>
</div>

<!-- THÔNG TIN KHÁCH HÀNG -->
<div class="card card-info card-outline mb-3">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="bi bi-person me-2"></i>Thông tin khách hàng</h5>
    </div>
    <div class="card-body ps-4 pe-4">
        <div class="row mb-2 pb-2" style="border-bottom: 1px dotted #ccc;">
            <div class="col-md-3 fw-bold">Khách hàng</div>
            <div class="col-md-3">@Model.CustomerName</div>
            <div class="col-md-3 fw-bold">Tên giao dịch</div>
            <div class="col-md-3">@Model.CustomerContactName</div>
        </div>
        <div class="row mb-2 pb-2" style="border-bottom: 1px dotted #ccc;">
            <div class="col-md-3 fw-bold">Email</div>
            <div class="col-md-3">@Model.CustomerEmail</div>
            <div class="col-md-3 fw-bold">Điện thoại</div>
            <div class="col-md-3">@Model.CustomerPhone</div>
        </div>
        <div class="row pt-2">
            <div class="col-md-3 fw-bold">Địa chỉ</div>
            <div class="col-md-9">@Model.CustomerAddress</div>
        </div>
    </div>
</div>

<!-- THÔNG TIN GIAO HÀNG -->
<div class="card card-success card-outline mb-3">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="bi bi-truck me-2"></i>Thông tin giao hàng</h5>
    </div>
    <div class="card-body ps-4 pe-4">
        <div class="row mb-2 pb-2" style="border-bottom: 1px dotted #ccc;">
            <div class="col-md-3 fw-bold">Người giao hàng</div>
            <div class="col-md-3">@(string.IsNullOrEmpty(Model.ShipperName) ? "—" : Model.ShipperName)</div>
            <div class="col-md-3 fw-bold">Điện thoại</div>
            <div class="col-md-3">@(string.IsNullOrEmpty(Model.ShipperPhone) ? "—" : Model.ShipperPhone)</div>
        </div>
        <div class="row mb-2 pb-2" style="border-bottom: 1px dotted #ccc;">
            <div class="col-md-3 fw-bold">Địa chỉ giao</div>
            <div class="col-md-9">@Model.DeliveryAddress</div>
        </div>
        <div class="row pt-2">
            <div class="col-md-3 fw-bold">Tỉnh / Thành</div>
            <div class="col-md-9">@Model.DeliveryProvince</div>
        </div>
    </div>
</div>

<!-- DANH SÁCH MẶT HÀNG -->
<div class="card card-secondary card-outline">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="bi bi-box-seam me-2"></i>Danh sách mặt hàng</h5>
    </div>
    <div class="card-body table-responsive p-2">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-secondary text-center">
                <tr>
                    <th style="width:50px">STT</th>
                    <th>Tên hàng</th>
                    <th style="width:80px">ĐVT</th>
                    <th style="width:100px">Số lượng</th>
                    <th style="width:150px">Giá bán</th>
                    <th style="width:150px">Thành tiền</th>
                    @if (Model.Status == SV22T1020161.Models.Sales.OrderStatusEnum.New
                      || Model.Status == SV22T1020161.Models.Sales.OrderStatusEnum.Accepted)
                    {
                        <th style="width:90px"></th>
                    }
                </tr>
            </thead>
            <tbody>
                @{
                    int stt = 1;
                    decimal total = 0;
                }
                @foreach (var item in details)
                {
                    var itemTotal = item.Quantity * item.SalePrice;
                    total += itemTotal;
                    <tr>
                        <td class="text-center">@(stt++)</td>
                        <td>@item.ProductName</td>
                        <td class="text-center">@item.Unit</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end">@item.SalePrice.ToString("N0") ₫</td>
                        <td class="text-end fw-semibold">@itemTotal.ToString("N0") ₫</td>
                        @if (Model.Status == SV22T1020161.Models.Sales.OrderStatusEnum.New
                          || Model.Status == SV22T1020161.Models.Sales.OrderStatusEnum.Accepted)
                        {
                            <td class="text-end text-nowrap">
                                <a href="~/Order/EditCartItem/@Model.OrderID?productId=@item.ProductID" class="btn btn-sm btn-primary open-modal" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="~/Order/DeleteCartItem/@Model.OrderID?productId=@item.ProductID" class="btn btn-sm btn-danger open-modal" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-primary">
                    <th colspan="@(Model.Status == SV22T1020161.Models.Sales.OrderStatusEnum.New || Model.Status == SV22T1020161.Models.Sales.OrderStatusEnum.Accepted ? 5 : 5)" class="text-end">Tổng cộng:</th>
                    <th class="text-end text-danger fw-bold">@total.ToString("N0") ₫</th>
                    @if (Model.Status == SV22T1020161.Models.Sales.OrderStatusEnum.New
                      || Model.Status == SV22T1020161.Models.Sales.OrderStatusEnum.Accepted)
                    {
                        <th></th>
                    }
                </tr>
            </tfoot>
        </table>
    </div>
</div>
