@model SV22T1020161.Models.Common.PagedResult<SV22T1020161.Models.Sales.OrderViewInfo>
@{
    Layout = null;
    var statusColors = new Dictionary<int, string>
    {
        { -2, "bg-danger" },
        { -1, "bg-secondary" },
        { 1, "bg-warning text-dark" },
        { 2, "bg-info" },
        { 3, "bg-primary" },
        { 4, "bg-success" }
    };
    var statusLabels = new Dictionary<int, string>
    {
        { -2, "Từ chối" },
        { -1, "Đã hủy" },
        { 1, "Chờ duyệt" },
        { 2, "Đã duyệt" },
        { 3, "Đang giao" },
        { 4, "Hoàn tất" }
    };
}

<div class="mb-2 text-muted">
    Danh sách này có <strong>@Model.RowCount</strong> đơn hàng. Trang <strong>@Model.Page/@Model.PageCount</strong>
</div>

<div class="card">
    <div class="card-body p-1">
        <table class="table table-bordered table-hover mb-0 align-middle">
            <thead class="table-secondary">
                <tr>
                    <th>Mã đơn</th>
                    <th>Ngày đặt</th>
                    <th>Tên khách hàng</th>
                    <th>Điện thoại</th>
                    <th>Người xử lý</th>
                    <th class="text-end">Tổng tiền</th>
                    <th class="text-center">Trạng thái</th>
                    <th style="width:50px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.DataItems)
                {
                    var badgeClass = statusColors.GetValueOrDefault((int)item.Status, "bg-secondary");
                    var label = statusLabels.GetValueOrDefault((int)item.Status, "Không xác định");
                    <tr>
                        <td class="text-center fw-semibold">@item.OrderID</td>
                        <td>@item.OrderTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.CustomerName</td>
                        <td>@item.CustomerPhone</td>
                        <td>@(string.IsNullOrEmpty(item.EmployeeName) ? "—" : item.EmployeeName)</td>
                        <td class="text-end fw-bold text-danger">@item.TotalAmount.ToString("N0") ₫</td>
                        <td class="text-center">
                            <span class="badge @badgeClass">@label</span>
                        </td>
                        <td class="text-center text-nowrap">
                            <a href="~/Order/Detail/@item.OrderID" class="btn btn-sm btn-primary" title="Chi tiết">
                                <i class="bi bi-receipt"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card-footer">
        @if (Model.PageCount > 1)
        {
            <ul class="pagination justify-content-center mb-0">
                @foreach (var p in Model.GetDisplayPages())
                {
                    if (p.Page == 0)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                    else if (p.IsCurrent)
                    {
                        <li class="page-item active"><span class="page-link">@p.Page</span></li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link" href="javascript:;" onclick="doSearch(@p.Page)">@p.Page</a>
                        </li>
                    }
                }
            </ul>
        }
    </div>
</div>
