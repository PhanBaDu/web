@model SV22T1020161.Models.Catalog.Product
@{
    ViewBag.Title = "Cập nhật mặt hàng";
}
<form asp-action="Edit" method="post">
    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title">Thông tin cơ bản</h3>
                </div>
                <div class="card-body">
                    <input type="hidden" name="ProductID" value="@Model.ProductID" />

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Tên mặt hàng <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-lg" name="ProductName"
                               value="@Model.ProductName" placeholder="Ví dụ: iPhone 15 Pro Max"
                               required maxlength="255"
                               oninvalid="this.setCustomValidity('Vui lòng nhập tên mặt hàng')"
                               oninput="this.setCustomValidity('')" />
                        @Html.ValidationMessage("ProductName", new { @class = "text-danger" })
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Loại hàng <span class="text-danger">*</span></label>
                            <select class="form-select" name="CategoryID" required
                                    oninvalid="this.setCustomValidity('Vui lòng chọn loại hàng')"
                                    onchange="this.setCustomValidity('')">
                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var item in ViewBag.Categories.DataItems)
                                    {
                                        if (item.CategoryID == Model.CategoryID)
                                        {
                                            <option value="@item.CategoryID" selected>@item.CategoryName</option>
                                        }
                                        else
                                        {
                                            <option value="@item.CategoryID">@item.CategoryName</option>
                                        }
                                    }
                                }
                            </select>
                            @Html.ValidationMessage("CategoryID", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Nhà cung cấp <span class="text-danger">*</span></label>
                            <select class="form-select" name="SupplierID" required
                                    oninvalid="this.setCustomValidity('Vui lòng chọn nhà cung cấp')"
                                    onchange="this.setCustomValidity('')">
                                @if (ViewBag.Suppliers != null)
                                {
                                    foreach (var item in ViewBag.Suppliers.DataItems)
                                    {
                                        if (item.SupplierID == Model.SupplierID)
                                        {
                                            <option value="@item.SupplierID" selected>@item.SupplierName</option>
                                        }
                                        else
                                        {
                                            <option value="@item.SupplierID">@item.SupplierName</option>
                                        }
                                    }
                                }
                            </select>
                            @Html.ValidationMessage("SupplierID", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Đơn vị tính <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="Unit"
                                   value="@Model.Unit" placeholder="Cái, Chiếc, Bộ..."
                                   required maxlength="255"
                                   oninvalid="this.setCustomValidity('Vui lòng nhập đơn vị tính')"
                                   oninput="this.setCustomValidity('')" />
                            @Html.ValidationMessage("Unit", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">₫</span>
                                <input type="number" class="form-control fw-bold text-dark" name="Price"
                                       value="@Model.Price" placeholder="0" min="0" step="1000"
                                       required
                                       oninvalid="this.setCustomValidity('Vui lòng nhập giá bán')"
                                       oninput="this.setCustomValidity('')" />
                            </div>
                            @Html.ValidationMessage("Price", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label fw-semibold">Mô tả sản phẩm</label>
                        <textarea class="form-control" name="ProductDescription" rows="6"
                                  placeholder="Nhập đặc điểm nổi bật, thông số kỹ thuật..."
                                  maxlength="2000">@Model.ProductDescription</textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title">Thiết lập hiển thị</h3>
                </div>
                <div class="card-body">
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="IsSelling"
                               value="true" @(Model.IsSelling ? "checked" : "") id="IsSelling" />
                        <label class="form-check-label fw-medium" for="IsSelling">Đăng bán ngay</label>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title">Xác nhận</h3>
                </div>
                <div class="card-body">
                    <button type="submit" class="btn btn-primary w-100 mb-2">
                        <i class="bi bi-check-lg me-2"></i> Lưu thay đổi
                    </button>
                    <a href="~/Product" class="btn btn-light border w-100">
                        Hủy và thoát
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="text-danger">
        @Html.ValidationSummary(true)
    </div>
</form>
