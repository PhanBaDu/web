@using System.Linq
@using SV22T1020161.Models.Catalog
@{
    var standalone = ViewData["ProductListPhotosStandalone"] as bool? == true;
    Layout = standalone ? "_Layout" : null;

    int productId = 0;
    var photoList = new List<ProductPhoto>();

    if (Model is Product prod)
    {
        productId = prod.ProductID;
        if (ViewBag.Photos is IEnumerable<ProductPhoto> fromBag)
            photoList = fromBag.ToList();
    }
    else if (Model is IList<ProductPhoto> list)
    {
        photoList = list.ToList();
        productId = ViewBag.ProductID is int pid ? pid : photoList.FirstOrDefault()?.ProductID ?? 0;
    }
    else if (Model is IEnumerable<ProductPhoto> seq)
    {
        photoList = seq.ToList();
        productId = ViewBag.ProductID is int pid2 ? pid2 : photoList.FirstOrDefault()?.ProductID ?? 0;
    }
}
<div class="row justify-content-center">
    <div class="col-12">
        <div class="card card-info card-outline mt-4">
            <div class="card-header">
                <div class="row">
                    <div class="col">
                        <h6 id="photos" class="mb-0">
                            <i class="bi bi-camera me-2"></i>
                            Thư viện ảnh
                        </h6>
                    </div>
                    <div class="col text-end">
                        @if (productId > 0)
                        {
                            <a class="btn btn-sm btn-primary" href="~/Product/CreatePhoto/@productId">
                                <i class="bi bi-plus-circle me-1"></i>
                                Thêm ảnh
                            </a>
                        }
                        else
                        {
                            <span class="text-muted small align-middle">Lưu mặt hàng trước khi thêm ảnh</span>
                        }
                    </div>
                </div>
            </div>

            <div class="card-body p-1">
                <table class="table table-bordered table-hover mb-0">
                    <thead class="table-secondary">
                        <tr>
                            <th style="width:120px">Ảnh</th>
                            <th>Mô tả</th>
                            <th style="width:120px" class="text-center">Thứ tự</th>
                            <th style="width:120px" class="text-center">Hiển thị</th>
                            <th style="width:100px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (photoList.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">Chưa có ảnh nào.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in photoList)
                            {
                                <tr>
                                    <td class="text-center">
                                        <img src="@(string.IsNullOrEmpty(item.Photo) ? Url.Content("~/images/products/noproduct.png") : Url.Content("~/images/products/" + item.Photo))"
                                             class="img-thumbnail"
                                             style="max-height:80px;" alt="@item.Description" />
                                    </td>
                                    <td>@item.Description</td>
                                    <td class="text-center">@item.DisplayOrder</td>
                                    <td class="text-center">
                                        @if (item.IsHidden)
                                        {
                                            <span class="badge bg-secondary">Ẩn</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Hiện</span>
                                        }
                                    </td>
                                    <td class="text-center text-nowrap">
                                        <a class="btn btn-sm btn-primary" href="~/Product/EditPhoto/@productId?photoId=@item.PhotoID" title="Sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a class="btn btn-sm btn-danger" href="~/Product/DeletePhoto/@productId?photoId=@item.PhotoID" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
