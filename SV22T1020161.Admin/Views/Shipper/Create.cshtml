@model SV22T1020161.Models.Partner.Shipper
@{
    ViewBag.Title = "Bổ sung người giao hàng";
}
<div class="card card-primary card-outline mb-4">
    <div class="card-header">
        <h3 class="card-title">Bổ sung người giao hàng mới</h3>
    </div>
    <form asp-action="Create" method="post">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Tên người giao hàng <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="ShipperName"
                               value="@Model.ShipperName" placeholder="Nhập tên người giao hàng"
                               required maxlength="255" autofocus
                               oninvalid="this.setCustomValidity('Vui lòng nhập tên người giao hàng')"
                               oninput="this.setCustomValidity('')" />
                        @Html.ValidationMessage("ShipperName", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Điện thoại <span class="text-danger">*</span></label>
                        <input type="tel" class="form-control" name="Phone"
                               value="@Model.Phone" placeholder="Nhập số điện thoại"
                               required maxlength="20"
                               pattern="[0-9]{9,15}"
                               oninvalid="this.setCustomValidity('Số điện thoại phải là chữ số, từ 9 đến 15 ký tự')"
                               oninput="this.setCustomValidity('')" />
                        @Html.ValidationMessage("Phone", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="text-danger">
                @Html.ValidationSummary(true)
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Lưu thông tin
            </button>
            <a href="~/Shipper" class="btn btn-secondary">
                <i class="bi bi-x-circle"></i> Hủy bỏ
            </a>
        </div>
    </form>
</div>
