@model SV22T1020161.Models.Partner.Supplier
@{
    ViewBag.Title = "Cập nhật nhà cung cấp";
}
<div class="card card-primary card-outline mb-4">
    <div class="card-header">
        <h3 class="card-title">Cập nhật thông tin nhà cung cấp</h3>
    </div>
    <form asp-action="Edit" method="post">
        <div class="card-body">
            <input type="hidden" name="SupplierID" value="@Model.SupplierID" />

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Tên nhà cung cấp <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="SupplierName"
                               placeholder="Nhập tên nhà cung cấp" value="@Model.SupplierName"
                               required maxlength="255"
                               oninvalid="this.setCustomValidity('Vui lòng nhập tên nhà cung cấp')"
                               oninput="this.setCustomValidity('')" />
                        @Html.ValidationMessage("SupplierName", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Tên giao dịch <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="ContactName"
                               placeholder="Nhập tên giao dịch" value="@Model.ContactName"
                               required maxlength="255"
                               oninvalid="this.setCustomValidity('Vui lòng nhập tên giao dịch')"
                               oninput="this.setCustomValidity('')" />
                        @Html.ValidationMessage("ContactName", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Điện thoại</label>
                        <input type="tel" class="form-control" name="Phone"
                               placeholder="Nhập số điện thoại" value="@Model.Phone" maxlength="20"
                               pattern="[0-9]{9,15}"
                               oninvalid="this.setCustomValidity('Số điện thoại phải là chữ số, từ 9 đến 15 ký tự')"
                               oninput="this.setCustomValidity('')" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" name="Email"
                               placeholder="Nhập email" value="@Model.Email" maxlength="255"
                               oninvalid="this.setCustomValidity('Vui lòng nhập địa chỉ email hợp lệ')"
                               oninput="this.setCustomValidity('')" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Tỉnh/Thành phố</label>
                        <select class="form-select" name="Province">
                            <option value="">-- Chọn tỉnh/thành --</option>
                            @if (ViewBag.Provinces != null)
                            {
                                foreach (var item in ViewBag.Provinces)
                                {
                                    if (item.ProvinceName == Model.Province)
                                    {
                                        <option value="@item.ProvinceName" selected>@item.ProvinceName</option>
                                    }
                                    else
                                    {
                                        <option value="@item.ProvinceName">@item.ProvinceName</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Địa chỉ</label>
                        <textarea class="form-control" name="Address" rows="3"
                                  placeholder="Nhập địa chỉ" maxlength="255">@Model.Address</textarea>
                    </div>
                </div>
            </div>

            <div class="text-danger">
                @Html.ValidationSummary(true)
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Lưu thông tin
            </button>
            <a href="~/Supplier" class="btn btn-secondary">
                <i class="bi bi-x-circle"></i> Hủy bỏ
            </a>
        </div>
    </form>
</div>
