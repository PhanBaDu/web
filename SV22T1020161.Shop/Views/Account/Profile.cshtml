@model SV22T1020161.Models.Partner.Customer
@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<div class="animate-in">
    <!-- Page Header -->
    <div class="page-header mb-5">
        <div class="page-header-icon">
            <i class="bi bi-person-gear" style="font-size:1.25rem;"></i>
        </div>
        <div>
            <h1 style="font-size:1.75rem;font-weight:800;">Tài khoản của tôi</h1>
            <p class="text-muted-md mb-0" style="font-size:0.875rem;">Quản lý thông tin cá nhân và bảo mật</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3">
            <div class="md-profile-nav" style="background: #ffffff !important; border: none !important; border-radius: 16px; overflow: hidden; box-shadow: none !important; color: var(--md-on-surface);">
                <div class="nav-header" style="padding: 24px; border-bottom: 1px solid var(--md-outline-variant); background: #ffffff !important;">
                    <div style="width:56px;height:56px;border-radius:var(--md-radius-full);background:linear-gradient(135deg,var(--md-primary),var(--md-tertiary));display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:1.25rem;flex-shrink:0;margin-bottom:12px;">
                        @(Model?.CustomerName?.Length > 0 ? Model.CustomerName.Substring(0, 1).ToUpper() : "U")
                    </div>
                    <div>
                        <h4 style="font-weight:700;font-size:1rem;margin-bottom:4px;color:var(--md-on-surface);">@(Model?.CustomerName ?? "Người dùng")</h4>
                        <p style="font-size:0.875rem;color:var(--md-on-surface-variant);margin:0;">@(Model?.Email)</p>
                    </div>
                </div>
                <nav class="nav flex-column" style="padding: 12px;">
                    <style>
                        .profile-nav-btn {
                            display: flex;
                            align-items: center;
                            gap: 12px;
                            padding: 12px 16px;
                            border-radius: 12px;
                            color: var(--md-on-surface-variant);
                            font-weight: 500;
                            text-decoration: none;
                            transition: all 0.2s ease;
                            margin-bottom: 4px;
                        }
                        .profile-nav-btn:hover {
                            background: var(--md-surface-container-low);
                            color: var(--md-primary);
                        }
                        .profile-nav-btn i {
                            font-size: 1.25rem;
                        }
                        .profile-nav-btn.logout-btn:hover {
                            background: var(--md-error-container);
                            color: var(--md-error);
                        }
                    </style>
                    <a href="#info" class="profile-nav-btn">
                        <i class="bi bi-person"></i> Thông tin cá nhân
                    </a>
                    <a href="#password" class="profile-nav-btn">
                        <i class="bi bi-shield-lock"></i> Đổi mật khẩu
                    </a>
                    <div style="height:1px;background:var(--md-outline-variant);margin:12px 16px;"></div>
                    <a href="~/Order/History" class="profile-nav-btn">
                        <i class="bi bi-receipt"></i> Đơn hàng của tôi
                    </a>
                    <a href="~/Account/Logout" class="profile-nav-btn logout-btn" style="color:var(--md-error);">
                        <i class="bi bi-box-arrow-right"></i> Đăng xuất
                    </a>
                </nav>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="col-lg-9 d-flex flex-column gap-4">

            <!-- Profile Info Section -->
            <section id="info" class="md-card">
                <div class="md-card-header">
                    <div class="md-card-icon" style="background:var(--md-primary-container);color:var(--md-primary);">
                        <i class="bi bi-person"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h3 style="font-size:1rem;font-weight:700;margin:0;">Thông tin cá nhân</h3>
                        <p class="text-muted-md mb-0" style="font-size:0.8125rem;">Cập nhật thông tin chi tiết và địa chỉ liên lạc của bạn.</p>
                    </div>
                    <button type="submit" form="profileForm" class="md-btn md-btn-primary">
                        <i class="bi bi-check2-circle"></i> Lưu thay đổi
                    </button>
                </div>
                <div class="md-card-body">
                    <form id="profileForm" action="~/Account/UpdateProfile" method="post" class="d-flex flex-column gap-4">
                        <div class="row g-3">
                            <!-- Full Name -->
                            <div class="col-md-6">
                                <div class="md-form-group mb-0">
                                    <label class="md-label">Họ và tên</label>
                                    <input type="text" name="CustomerName" value="@Model?.CustomerName" class="md-input" />
                                </div>
                            </div>
                            <!-- Email (Read-only) -->
                            <div class="col-md-6">
                                <div class="md-form-group mb-0">
                                    <label class="md-label">Email (Không thể thay đổi)</label>
                                    <input type="email" value="@Model?.Email" disabled class="md-input" style="background:var(--md-surface-variant);cursor:not-allowed;" />
                                </div>
                            </div>
                            <!-- Phone -->
                            <div class="col-md-6">
                                <div class="md-form-group mb-0">
                                    <label class="md-label">Số điện thoại</label>
                                    <input type="tel" name="Phone" value="@Model?.Phone" class="md-input" />
                                </div>
                            </div>
                            <!-- Province -->
                            <div class="col-md-6">
                                <div class="md-form-group mb-0">
                                    <label class="md-label">Tỉnh / Thành phố</label>
                                    <select name="Province" class="md-select">
                                        <option value="">-- Chọn tỉnh/thành --</option>
                                        @foreach (var province in await SV22T1020161.BusinessLayers.DictionaryDataService.ListProvincesAsync())
                                        {
                                            <option value="@province.ProvinceName" selected="@(province.ProvinceName == Model?.Province)">
                                                @province.ProvinceName
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <!-- Address -->
                        <div>
                            <div class="md-form-group mb-0">
                                <label class="md-label">Địa chỉ cụ thể</label>
                                <textarea name="Address" rows="2" class="md-input" style="resize:none;">@Model?.Address</textarea>
                            </div>
                        </div>
                    </form>
                </div>
            </section>

            <!-- Change Password Section -->
            <section id="password" class="md-card">
                <div class="md-card-header">
                    <div class="md-card-icon" style="background:var(--md-secondary-container);color:var(--md-secondary);">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <div>
                        <h3 style="font-size:1rem;font-weight:700;margin:0;">Đổi mật khẩu</h3>
                        <p class="text-muted-md mb-0" style="font-size:0.8125rem;">Nên sử dụng mật khẩu mạnh để bảo vệ tài khoản.</p>
                    </div>
                </div>
                <div class="md-card-body">
                    <form action="~/Account/ChangePassword" method="post" class="d-flex flex-column gap-4" style="max-width:480px;">
                        <div class="md-form-group mb-0">
                            <label class="md-label">Mật khẩu hiện tại</label>
                            <div class="md-input-wrap">
                                <i class="bi bi-lock input-icon"></i>
                                <input type="password" name="oldPassword" placeholder="Nhập mật khẩu hiện tại" required class="md-input" />
                            </div>
                        </div>
                        <div class="md-form-group mb-0">
                            <label class="md-label">Mật khẩu mới</label>
                            <div class="md-input-wrap">
                                <i class="bi bi-key input-icon"></i>
                                <input type="password" name="newPassword" placeholder="Tối thiểu 6 ký tự" required minlength="6" class="md-input" />
                            </div>
                        </div>
                        <div class="md-form-group mb-0">
                            <label class="md-label">Xác nhận mật khẩu mới</label>
                            <div class="md-input-wrap">
                                <i class="bi bi-shield-check input-icon"></i>
                                <input type="password" name="confirmPassword" placeholder="Nhập lại mật khẩu mới" required class="md-input" />
                            </div>
                        </div>
                        <div>
                            <button type="submit" class="md-btn md-btn-outlined">
                                <i class="bi bi-key"></i> Cập nhật mật khẩu
                            </button>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.md-profile-nav .nav-item[href^="#"]').forEach(function(link) {
            link.addEventListener('click', function(e) {
                var target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    e.preventDefault();
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });
    </script>
}
